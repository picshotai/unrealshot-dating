{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "components/supportingpages/**",
    "components/image-canvas.tsx",
    "components/imageInspector.tsx",
    "components/mobile-panel.tsx",
    "components/mobile-unified-panel.tsx",
    "components/right-panel.tsx",
    "components/dashboard/mini-stats.tsx",
    "components/ui/chart.tsx",
    "hooks/useannotations.ts",
    "hooks/useCanvas.ts"
  ]
}
